---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, getPostSlug, getPublishedPosts } from '../lib/writing';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <main class="home-page">
    <section class="intro" aria-labelledby="intro-heading">
      <h1 id="intro-heading">I build products, teams, and the systems that help both grow.</h1>
      <div class="intro-summary">
        <p>I'm Luthfi, currently CTO at Aixel and Head of Technology at NoEffort.</p>
        <p>I care about turning ambitious ideas into useful products and creating the clarity engineering teams need to do their best work.</p>
      </div>
    </section>

    <section class="content-section current-section" id="currently" aria-labelledby="currently-heading">
      <header class="section-intro">
        <h2 class="section-heading" id="currently-heading">Currently</h2>
      </header>
      <ol class="experience-list">
        <li>
          <p class="role-company">Aixel</p>
          <div>
            <h3>Chief Technology Officer</h3>
            <p>Leading technology and engineering.</p>
          </div>
        </li>
        <li>
          <p class="role-company">NoEffort</p>
          <div>
            <h3>Head of Technology</h3>
            <p>Leading technology and how products get built.</p>
          </div>
        </li>
      </ol>
    </section>

    {posts.length > 0 && (
      <section class="content-section writing-section" id="writing" aria-labelledby="writing-heading">
        <header class="section-intro">
          <h2 class="section-heading" id="writing-heading">Writing</h2>
        </header>
        <ol class="post-list">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${getPostSlug(post)}/`}>{post.data.title}</a>
              <time class="post-date" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
              <p class="post-description">{post.data.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-copy">
        <h2 id="contact-heading">Let's start a conversation.</h2>
        <p>If you'd like to talk about products, engineering, or building teams, send me a note.</p>
        <a class="contact-email" href="mailto:contact@luthfisolahudin.id">contact@luthfisolahudin.id</a>
      </div>
      <ul class="contact-links" aria-label="Social links">
        <li><a href="https://github.com/luthfisolahudin">GitHub</a></li>
        <li><a href="https://www.linkedin.com/in/luthfisolahudin/">LinkedIn</a></li>
        {posts.length > 0 && <li><a href="/rss.xml">RSS</a></li>}
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <p>© 2026 Luthfi Solahudin.</p>
  </footer>
</BaseLayout>
